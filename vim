" ---------------------
" General
" ---------------------
syntax on
filetype plugin indent on
set mouse=a
set number
set tabstop=2
set shiftwidth=2
set expandtab
set autoindent
set hlsearch
set incsearch
set ignorecase
set smartcase
set backspace=indent,eol,start

" ---------------------
" NERDTree
" ---------------------
nnoremap <C-n> :NERDTreeToggle<CR>
let NERDTreeMouseMode=2
let NERDTreeShowHidden=1
